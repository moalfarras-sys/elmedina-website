# El Medina - Environment Variables
# Copy this file to .env.local and fill in the values

# Admin credentials (change in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=elmedina2024
ADMIN_SESSION_SECRET=change-this-secret-in-production

# Public site URL used for SEO metadata
# Example: https://your-project.vercel.app
# NEXT_PUBLIC_SITE_URL=

# Optional: Database URL (for future Supabase/Postgres integration)
# DATABASE_URL=

# Optional: Email service (for reservation notifications)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# NOTIFICATION_EMAIL=

# Optional: Google Maps API key
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=
